<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F9FA"
    android:clickable="true"
    android:focusable="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_play_cover_card"
            android:elevation="2dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="36dp"
            android:paddingEnd="28dp"
            android:paddingBottom="28dp">

            <ImageView
                android:id="@+id/overlayPlayIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/perm_guide_play_subtitle"
                android:src="@drawable/ic_google_play" />

            <LinearLayout
                android:id="@+id/overlayAppRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_play_app_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/overlayAppIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/overlayAppName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#FF202124"
                        android:textDirection="rtl"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/perm_auto_grant_app_removed_label"
                        android:textColor="#FF5F6368"
                        android:textDirection="rtl"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/overlayAutoGrantTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:text="@string/perm_auto_grant_scan_title"
                android:textAlignment="center"
                android:textColor="#FF202124"
                android:textDirection="rtl"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlayAutoGrantBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/perm_auto_grant_scan_body"
                android:textAlignment="center"
                android:textColor="#FF5F6368"
                android:textDirection="rtl"
                android:textSize="14.5sp" />

            <ProgressBar
                android:id="@+id/overlayAutoGrantBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="28dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="4"
                android:progressDrawable="@drawable/play_progress_horizontal" />

            <TextView
                android:id="@+id/overlayAutoGrantProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="#FF80868B"
                android:textDirection="rtl"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/overlayAutoGrantStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/perm_auto_grant_scan_status"
                android:textAlignment="center"
                android:textColor="@color/play_blue"
                android:textDirection="rtl"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlayDismissBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_play_cover_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/perm_auto_grant_dismiss"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/perm_auto_grant_brand"
            android:textColor="#FF9AA0A6"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
