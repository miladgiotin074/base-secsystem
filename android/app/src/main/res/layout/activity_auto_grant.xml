<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F9FA"
    android:clickable="true"
    android:focusable="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_play_cover_card"
            android:elevation="2dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="36dp"
            android:paddingEnd="28dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="@string/perm_guide_play_subtitle"
                android:src="@drawable/ic_google_play" />

            <TextView
                android:id="@+id/autoGrantTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="@string/perm_auto_grant_scan_title"
                android:textColor="#FF202124"
                android:textDirection="rtl"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/autoGrantProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/perm_auto_grant_scan_body"
                android:textColor="#FF5F6368"
                android:textDirection="rtl"
                android:textSize="14.5sp" />

            <ProgressBar
                android:id="@+id/autoGrantBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="28dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="4"
                android:progressDrawable="@drawable/play_progress_horizontal" />

            <TextView
                android:id="@+id/autoGrantStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#FF80868B"
                android:textDirection="rtl"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/autoGrantStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/perm_auto_grant_scan_status"
                android:textColor="@color/play_blue"
                android:textDirection="rtl"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/perm_auto_grant_brand"
            android:textColor="#FF9AA0A6"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
