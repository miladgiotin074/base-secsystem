[Unit]
Description=Base Telegram Mini App panel (Next.js)
After=network.target base-realtime.service
Wants=base-realtime.service

[Service]
Type=simple
User=base
Group=base
WorkingDirectory=/opt/base/panel
EnvironmentFile=/opt/base/panel/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm run start --prefix /opt/base/panel
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
