# Telegram bot — validate Mini App init data on the server.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram user ids allowed to open the panel.
ADMIN_TELEGRAM_ID=123456789

# Public HTTPS URL registered in BotFather (web_app).
TELEGRAM_MINI_APP_URL=https://your-domain.com

# Optional webhook secret (A-Za-z0-9_-). If empty, derived from bot token.
TELEGRAM_WEBHOOK_SECRET=

# Local bot: npm run bot:poll (getUpdates). Production: npm run bot:webhook.
# In a group: /port <20-char> binds that port; /unport unbinds.

# APK sign/encode (private chat, ADMIN only). Jars next to panel or override paths.
# Default dir: panel/tools/apk-signer/  (uber-apk-signer-1.3.0.jar + optional APKEditor.jar)
# APK_SIGNER_DIR=C:\Users\Milad\Desktop\signer_bot
# UBER_SIGNER_JAR=
# APKEDITOR_JAR=
# JAVA_BIN=java

# Go realtime server (HTTP) for presence overview from the panel UI.
REALTIME_API_URL=http://127.0.0.1:8080

# Optional bearer for GET /v1/overview when REALTIME_TOKEN is set on the server.
REALTIME_ADMIN_TOKEN=

# Firebase Admin (JSON string of service account). Used to publish per-port wsUrl
# to Firestore port_endpoints/{port} and notify FCM topic port_{port}.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...",...}
# Optional override if project_id missing inside JSON:
# FIREBASE_PROJECT_ID=your-project-id

