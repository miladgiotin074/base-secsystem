# Local only — copy to .env (gitignored)
TELEGRAM_BOT_TOKEN=
REALTIME_TELEGRAM_BOT_TOKEN=
# 32-byte AES key (base64 or hex). Same value as Android config.json frameKey.
REALTIME_FRAME_KEY=
# Ollama on a separate host (default local). Set empty to skip AI calls (give_up only).
REALTIME_AI_URL=http://127.0.0.1:11434/v1
# Bearer key for https://ollama.com. Leave empty for a local server.
REALTIME_AI_KEY=
REALTIME_AI_MODEL=qwen2.5:3b
REALTIME_AI_PROMPT=sms_v1
REALTIME_AI_TIMEOUT=25s
# Ollama process environment. Quit Ollama and start it again after this is set.
# OLLAMA_FLASH_ATTENTION=1
